{
  "name": "failcatcher-py312-cu126",
  "image": "failcatcher-py312-cu126",
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "runArgs": [
    "--gpus=all",
    "--cpus=16",
    "--memory=64g",
    "--shm-size=16g",
    "--security-opt=no-new-privileges",
    "--network=host"
  ],
  "remoteUser": "root",
  "mounts": [
    "source=/etc/ssl/certs/ZscalerRoot0.pem,target=/usr/local/share/ca-certificates/zscaler.crt,type=bind"
  ],
  "postCreateCommand": "apt-get update && apt-get install -y git curl ca-certificates && update-ca-certificates && git config --global --add safe.directory /workspace",
  "remoteEnv": {
    "HTTP_PROXY": "http://185.46.212.97:80",
    "HTTPS_PROXY": "http://185.46.212.97:80",
    "http_proxy": "http://185.46.212.97:80",
    "https_proxy": "http://185.46.212.97:80",
    "NODE_EXTRA_CA_CERTS": "/usr/local/share/ca-certificates/zscaler.crt",
    "REQUESTS_CA_BUNDLE": "/etc/ssl/certs/ca-certificates.crt",
    "SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt"
  }
}